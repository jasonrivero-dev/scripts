#!/usr/bin/env bash
set -euo pipefail

# Builds the novarc-licensing .deb (and example client binaries, if not
# already built) and copies everything needed to QA-test it on a bare EC2
# box - the package plus the installed-path-safe scripts, nothing that needs
# the cargo workspace itself. Does not install or provision anything remotely
# - that's a manual step over your own SSH session, printed at the end.

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
CYAN='\033[1;96m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

log() {
    echo -e "[$(date +"%H:%M:%S")] [${GREEN}INFO${NC}] $*"
}

warn() {
    echo -e "[$(date +"%H:%M:%S")] [${YELLOW}WARN${NC}] $*"
}

error() {
    echo -e "[$(date +"%H:%M:%S")] [${RED}ERROR${NC}] $*" >&2
}

divider() {
    local color="${1:-}"
    echo -e "${color}======================================================================${NC}"
}

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")

REPO_DIR="${REPO_DIR:-$HOME/dev/licensing-poc}"
KEY_FILE="${KEY_FILE:-$HOME/.ec2/Edge-Licensing-Login-Pair.pem}"
REMOTE_USER="${REMOTE_USER:-ubuntu}"
REMOTE_HOST="${REMOTE_HOST:-35.162.41.238}"
# REMOTE_DIR's default is derived from REMOTE_USER, so it's resolved after
# argument parsing below (once -u has had a chance to override REMOTE_USER) -
# an explicit REMOTE_DIR env var override still wins over that derivation.
REMOTE_DIR_OVERRIDE="${REMOTE_DIR:-}"

# Installed-path-safe only - see docs/TOOLS.md / feedback_qa_scripts_installed_paths_only.
# dev_build and air_gap_cert_tool are deliberately excluded (dev-workspace-only).
SCRIPTS_TO_COPY=(
    common
    dev_lib
    entitlement_lib
    health
    dev_logs
    qa_manage_entitlement
    dev_test_entitlements
    dev_test_proxy
    dev_test_e2e
    dev_test_mitm
    qa_test_clients
)

section() { echo -e "  ${BOLD}${MAGENTA}--- $1 ---${NC}"; }
step() { echo -e "  ${BOLD}$1${NC}"; }
cmd() { echo -e "       ${CYAN}$1${NC}${2:+   ${DIM}$2${NC}}"; }
note() { echo -e "     ${DIM}$1${NC}"; }

print_next_steps() {
    local deb_basename="$1"
    step "Connect and move to the deploy directory:"
    cmd "${SSH_HINT} ${REMOTE_USER}@${REMOTE_HOST}"
    cmd "cd ${REMOTE_DIR}"
    echo
    section "Factory Provisioning (Admin) - see docs/OPERATOR_HOWTO.md"
    step "1. Install the package (ensures acl/tpm2-tools/curl/an NTP client first, then installs):"
    cmd "sudo ./install.sh ${deb_basename}"
    step "2. Bring-up check with a test license, as root:"
    cmd "sudo lictl init <test-license-id>"
    cmd "sudo lictl status"
    cmd "sudo lictl license" "# expect every entitlement GRANTED"
    step "3. Wipe the test license, bring the daemon back up:"
    cmd "sudo lictl reset"
    cmd "sudo lictl start"
    step "4. Generate the licensing_su password for this box (shown once - write it down):"
    cmd "sudo lictl licensing-su-password"
    echo
    section "Field Provisioning (Field Operator) - see docs/OPERATOR_HOWTO.md"
    step "5. Log in as licensing_su (no root involved from here on):"
    cmd "${SSH_HINT} licensing_su@${REMOTE_HOST}"
    note "If that's rejected (publickey) - this box's sshd may not allow password auth -"
    note "fall back to, from your existing ${REMOTE_USER} session:"
    cmd "sudo su - licensing_su"
    step "6. Provision the real license, then confirm:"
    cmd "lictl init <license-id>"
    cmd "lictl status"
    cmd "lictl license"
    note "Then leave this session (exit/logout) - it has zero sudo rights by design,"
    note "including for the QA scripts below."
    echo
    section "QA (back in the ${REMOTE_USER} session - licensing_su has no sudo)"
    step "7. Run the end-to-end test:"
    cmd "sudo scripts/dev_test_e2e"
    step "8. Run the client tests:"
    cmd "sudo scripts/qa_test_clients"
    step "9. Or run an example client directly (needs cwd inside examples/ - the"
    note "binary looks for config.toml relative to where it's run, not itself):"
    cmd "cd examples && bin/client-cpp noveye" "# no sudo needed - hits the daemon over HTTP"
    step "10. Tail the newest log, following restarts (celeste's tail-log.sh, shipped along):"
    cmd "scripts/tail-log.sh"
}

do_uninstall() {
    echo -e "${YELLOW}${BOLD}This will purge novarc-licensing and delete ${REMOTE_DIR} on ${REMOTE_HOST}.${NC}"
    read -r -p "Continue? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        log "Aborted."
        exit 0
    fi

    echo
    divider "${BOLD}${RED}"
    log "Uninstalling novarc-licensing from ${REMOTE_USER}@${REMOTE_HOST}"
    divider "${BOLD}${RED}"
    ssh -t "${SSH_KEY_OPTS[@]}" "${REMOTE_USER}@${REMOTE_HOST}" '
        set -e
        sudo dpkg --purge novarc-licensing || sudo dpkg --remove --force-remove-reinstreq novarc-licensing
        sudo apt-get -y --fix-broken install
        if dpkg -l novarc-licensing 2>/dev/null | grep -qE "^(ii|iU)"; then
            echo -e "\033[0;31mnovarc-licensing is still installed\033[0m" >&2
            exit 1
        fi
        echo -e "\033[0;32mnovarc-licensing removed.\033[0m"
        rm -rf "'"$REMOTE_DIR"'"
        echo -e "\033[0;32mRemoved deploy directory '"$REMOTE_DIR"'.\033[0m"
    '
    divider "${BOLD}${RED}"
    log "Uninstall complete."
    divider "${BOLD}${RED}"
}

ACTION="deploy"
TARGET_OVERRIDDEN=false
KEY_OVERRIDDEN=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) ACTION="help"; shift ;;
        --uninstall) ACTION="uninstall"; shift ;;
        -u) REMOTE_USER="$2"; TARGET_OVERRIDDEN=true; shift 2 ;;
        -s) REMOTE_HOST="$2"; TARGET_OVERRIDDEN=true; shift 2 ;;
        -k) KEY_FILE="$2"; KEY_OVERRIDDEN=true; shift 2 ;;
        *) error "Unknown argument: $1"; exit 1 ;;
    esac
done

REMOTE_DIR="${REMOTE_DIR_OVERRIDE:-/home/${REMOTE_USER}/licensing-deploy}"

# -u/-s alone mean a different box, reached with a password, not the default
# box's key - no -i is passed unless -k explicitly asks for one. Without
# -u/-s (the original single default box), the default key is required, same
# as always.
if $KEY_OVERRIDDEN || ! $TARGET_OVERRIDDEN; then
    if [ ! -f "$KEY_FILE" ]; then
        error "SSH key not found at $KEY_FILE (set KEY_FILE, or pass -k, to override)."
        exit 1
    fi
    SSH_KEY_OPTS=(-i "$KEY_FILE")
    SSH_HINT="ssh -i $KEY_FILE"
else
    SSH_KEY_OPTS=()
    SSH_HINT="ssh"
fi

if [ "$ACTION" = "help" ]; then
    echo "Usage: licadmin-ec2-deploy [--uninstall] [-u <user>] [-s <host>] [-k <keyfile>]"
    echo
    echo "Builds the .deb + example clients, copies them plus the installed-path-safe"
    echo "QA scripts to the EC2 box below. Does not install/provision anything remotely -"
    echo "these are the manual steps to run yourself afterward, over your own SSH session:"
    echo
    print_next_steps "novarc-licensing_<version>_<arch>.deb"
    echo
    echo "--uninstall: purges novarc-licensing and deletes ${REMOTE_DIR} on the box above,"
    echo "             after a y/N confirmation prompt. Connects over SSH and runs it directly."
    echo "-u <user>:    override the remote SSH user (default: ubuntu)."
    echo "-s <host>:    override the remote host/IP (default: 35.162.41.238)."
    echo "-k <keyfile>: use this SSH identity file instead of the default"
    echo "              ($HOME/.ec2/Edge-Licensing-Login-Pair.pem)."
    echo "              Passing -u and/or -s without -k means a different box, reached"
    echo "              with a password instead - no -i is sent, so ssh will prompt for"
    echo "              one directly. The default key is only used when neither -u nor"
    echo "              -s is given, or when -k explicitly asks for a key."
    exit 0
fi

if [ "$ACTION" = "uninstall" ]; then
    do_uninstall
    exit 0
fi

if [ ! -d "$REPO_DIR" ]; then
    error "Repo not found at $REPO_DIR (set REPO_DIR to override)."
    exit 1
fi

cd "$REPO_DIR"

log "Building .deb via ./build.sh deb..."
./build.sh deb

DEB_PATH=$(find target/debian -maxdepth 1 -name '*.deb' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
if [ -z "$DEB_PATH" ]; then
    error "No .deb found under target/debian after build."
    exit 1
fi
log "Built package: $DEB_PATH"

if [ ! -x "examples/bin/client-rust" ] || [ ! -x "examples/bin/client-go" ] || [ ! -x "examples/bin/client-cpp" ]; then
    log "Example client binaries missing - building locally via examples/build.sh..."
    (cd examples && ./build.sh)
fi

STAGE_DIR=$(mktemp -d)
trap 'rm -rf "$STAGE_DIR"' EXIT

log "Staging files in $STAGE_DIR..."
cp "$DEB_PATH" "$STAGE_DIR/"
cp package/install.sh "$STAGE_DIR/install.sh"
cp package/lib-colors.sh "$STAGE_DIR/lib-colors.sh"

mkdir -p "$STAGE_DIR/scripts"
for f in "${SCRIPTS_TO_COPY[@]}"; do
    cp "scripts/$f" "$STAGE_DIR/scripts/$f"
done
cp "${SCRIPT_DIR}/../celeste/tail-log.sh" "$STAGE_DIR/scripts/tail-log.sh"

mkdir -p "$STAGE_DIR/examples/bin"
cp examples/bin/client-rust examples/bin/client-go examples/bin/client-cpp "$STAGE_DIR/examples/bin/"
cp examples/config.toml "$STAGE_DIR/config.toml"

log "Copying to ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}..."
ssh "${SSH_KEY_OPTS[@]}" "${REMOTE_USER}@${REMOTE_HOST}" "mkdir -p '$REMOTE_DIR'"
scp "${SSH_KEY_OPTS[@]}" -r "$STAGE_DIR"/. "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/"

DEB_BASENAME=$(basename "$DEB_PATH")

log "Done. Files are at ${REMOTE_DIR} on the box. Next steps (manual, over your own SSH session):"
echo
print_next_steps "$DEB_BASENAME"
echo
if ! ssh "${SSH_KEY_OPTS[@]}" "${REMOTE_USER}@${REMOTE_HOST}" "dpkg -s libcurl4 || dpkg -s libcurl4t64" &>/dev/null; then
    warn "client-cpp needs libcurl4 (+ its TLS chain) at runtime - if it fails to run, 'sudo apt install -y libcurl4t64 || sudo apt install -y libcurl4'."
fi
