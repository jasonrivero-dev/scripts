# ==============================================================================
# Constants
# ==============================================================================
DOWNLOAD_DIR="${HOME}/dev/downloads"
LEFT_IP="10.64.0.221"
RIGHT_IP="10.64.0.188"

# AWS / Remote Server Constants
LICENSING_IP="35.91.120.7"
NOVPLAN_IP="34.215.27.32"
NOVPLAN_KEY="$HOME/.ssh/novplan-dev-box-PEM.pem"
EDGE_LICENSING_WEB_IP="44.255.206.14"
EDGE_LICENSING_WEB_KEY="$HOME/.ssh/edge licensing web dashboard.pem"
CAT_DEV_BASTION_HOST="ec2-34-210-9-1.us-west-2.compute.amazonaws.com"
CAT_DEV_BASTION_KEY="$HOME/.ssh/cat-dev-bastion-key-pair.pem"

# ==============================================================================
# Remote Server Management (Ubuntu & Amazon Linux)
# ==============================================================================

# Internal helper to resolve target server host, user, and SSH key
# Expects caller to declare: local _SRV_HOST _SRV_USER _SRV_KEY
_resolve_server() {
    local target="$1"
    local usage_msg="$2"

    _SRV_HOST=""
    _SRV_USER="ubuntu"
    _SRV_KEY="$NOVPLAN_KEY"

    case "$target" in
        novplan)
            _SRV_HOST="$NOVPLAN_IP"
            ;;
        licensing)
            _SRV_HOST="$LICENSING_IP"
            ;;
        edge-licensing-web)
            _SRV_HOST="$EDGE_LICENSING_WEB_IP"
            _SRV_KEY="$EDGE_LICENSING_WEB_KEY"
            ;;
        cat-dev)
            _SRV_HOST="$CAT_DEV_BASTION_HOST"
            _SRV_KEY="$CAT_DEV_BASTION_KEY"
            _SRV_USER="ec2-user"
            ;;
        *)
            echo "❌ Error: Invalid or missing target." >&2
            echo "$usage_msg" >&2
            return 1
            ;;
    esac

    if [[ ! -r "$_SRV_KEY" ]]; then
        echo "❌ Error: SSH key is missing or unreadable: $_SRV_KEY" >&2
        return 1
    fi

    return 0
}

# 1. Interactive SSH session
connect_server() {
    local _SRV_HOST _SRV_USER _SRV_KEY
    _resolve_server "$1" "Usage: connect_server <novplan|licensing|edge-licensing-web|cat-dev>" || return 1

    echo "🌐 Connecting to $1 Box ($_SRV_HOST) as $_SRV_USER..."
    ssh -i "$_SRV_KEY" "${_SRV_USER}@${_SRV_HOST}"
}

# 2. Copy files/folders to the remote server
cp_server() {
    local _SRV_HOST _SRV_USER _SRV_KEY
    local usage="Usage: cp_server <novplan|licensing|edge-licensing-web|cat-dev> <local_path_to_file_or_dir> [remote_destination_path]"
    _resolve_server "$1" "$usage" || return 1

    local source="$2"
    local dest="${3:-/home/${_SRV_USER}/}"

    if [[ -z "$source" ]]; then
        echo "❌ Error: Please specify the file or directory you want to copy." >&2
        echo "$usage" >&2
        return 1
    fi

    echo "🚀 Uploading '$source' to ${_SRV_USER}@${_SRV_HOST}:${dest}..."
    scp -r -i "$_SRV_KEY" "$source" "${_SRV_USER}@${_SRV_HOST}:${dest}"
}

# 3. Run a command on the remote server
exec_server() {
    local _SRV_HOST _SRV_USER _SRV_KEY
    local usage="Usage: exec_server <novplan|licensing|edge-licensing-web|cat-dev> <command>"
    _resolve_server "$1" "$usage" || return 1

    local target="$1"
    shift
    local cmd="$*"

    if [[ -z "$cmd" ]]; then
        echo "❌ Error: Please specify the command to run." >&2
        echo "$usage" >&2
        return 1
    fi

    echo "⚙️  Running on $target Box ($_SRV_HOST) as $_SRV_USER: $cmd"
    ssh -i "$_SRV_KEY" "${_SRV_USER}@${_SRV_HOST}" "$cmd"
}

# Backward-compatible wrappers
connect_ubuntu() { connect_server "$@"; }
cp_ubuntu()      { cp_server "$@"; }
exec_ubuntu()    { exec_server "$@"; }

# ==============================================================================
# Deployment & IPC Utilities
# ==============================================================================

fetch_and_deploy_celeste() {
    local version=""
    local ubuntu_version="22.04-x64"
    local side="any"
    
    local TARGET_IP=""

    usage() {
        echo "Usage: fetch_and_deploy_celeste [version] [os-arch] [side]"
        echo "  side: 'left' (221), 'right' (188), or 'any'"
    }

    if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]] || [[ -z "$1" ]]; then
        usage; return 0
    fi

    version="$1"
    [[ -n "$2" ]] && ubuntu_version="$2"
    [[ -n "$3" ]] && side="$3"

    if [[ "$side" != "left" && "$side" != "right" && "$side" != "any" ]]; then
        error "Invalid side '$side'. Must be 'left', 'right', or 'any'."
        usage
        return 1
    fi

    local ubuntu_folder_suffix="${ubuntu_version%-*}"
    local deb_name="celeste-ubuntu_${ubuntu_version}-${version}.deb"
    local s3_uri="s3://novarc-artifacts/celeste/ubuntu_${ubuntu_folder_suffix}/${deb_name}"
    local target_path="${DOWNLOAD_DIR}/${deb_name}"

    mkdir -p "$DOWNLOAD_DIR"
    
    # 1. Resilient Download (Handling 2.5GB file)
    if [[ -f "$target_path" ]]; then
        log "Package exists at $target_path. Skipping download."
    else
        log "Downloading $deb_name (2.5GB) from S3..."
        # Increased timeouts to prevent 'Connection reset by peer'
        if ! aws s3 cp "$s3_uri" "$target_path" --cli-read-timeout 600 --cli-connect-timeout 600; then
            error "Failed to download $deb_name from S3."
            return 1
        fi
    fi

    # 2. Package & Plugin Verification
    log "Verifying package structure and plugins..."
    if ! ls -lh "$target_path" >/dev/null 2>&1; then
        error "File $target_path is missing or inaccessible."
        return 1
    fi

    if ! dpkg -c "$target_path" | grep -q "opt/novarc/apps/celeste/plugins/libffmpeg_recorder.so"; then
        error "CRITICAL: libffmpeg_recorder.so is MISSING from the .deb package!"
        return 1
    fi
    log "Verification passed: Plugin found."

    # 3. Machine Selection (Ping)
    if [[ "$side" == "left" ]]; then
        TARGET_IP="$LEFT_IP"
    elif [[ "$side" == "right" ]]; then
        TARGET_IP="$RIGHT_IP"
    else
        log "Scanning for available IPC..."
        if ping -c 1 -W 1 "$RIGHT_IP" >/dev/null 2>&1; then
            TARGET_IP="$RIGHT_IP"
        elif ping -c 1 -W 1 "$LEFT_IP" >/dev/null 2>&1; then
            TARGET_IP="$LEFT_IP"
        fi
    fi

    if [[ -z "$TARGET_IP" ]] || ! ping -c 1 -W 1 "$TARGET_IP" >/dev/null 2>&1; then
        error "Target machine unreachable or not found. Side: $side"
        return 1
    fi

    # 4. Transfer
    log "Transferring to $TARGET_IP:/tmp ..."
    if scp "$target_path" "novarc@${TARGET_IP}:/tmp"; then
        log "Successfully deployed to $TARGET_IP"
    else
        error "SCP transfer failed."
        return 1
    fi
}

