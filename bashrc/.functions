deploy_plc() {
    # IP Configurations
    local TARGET_USER="novarc"
    local TARGET_DIR="/tmp/plc-lab"

    # Initial Defaults
    local SIDE="left"
    local TARGET_IP=$LEFT_IP
    local BUILD_MODE="debug"
    local RELEASE_FLAG=""

    # Argument Parsing (order doesn't matter)
    for arg in "$@"; do
        case $arg in
            right)
                SIDE="right"
                TARGET_IP=$RIGHT_IP
                ;;
            left)
                SIDE="left"
                TARGET_IP=$LEFT_IP
                ;;
            release)
                BUILD_MODE="release"
                RELEASE_FLAG="--release"
                ;;
        esac
    done

    local REMOTE_HOST="${TARGET_USER}@${TARGET_IP}"

    # 1. Build locally
    echo "--- Building Workspace ($BUILD_MODE) ---"
    cargo build $RELEASE_FLAG || return 1

    # 2. Deploy to targeted machine
    echo "--- Deploying ($BUILD_MODE) to $SIDE Machine ($TARGET_IP) ---"
    
    echo "1. Ensuring remote directory exists: $TARGET_DIR"
    ssh "$REMOTE_HOST" "mkdir -p $TARGET_DIR" || return 1

    echo "2. Copying binaries from target/$BUILD_MODE..."
    # Copying the four established workspace tools
    scp target/$BUILD_MODE/plc-msg-recv \
        target/$BUILD_MODE/plc-msg-send \
        target/$BUILD_MODE/fd-reader \
        target/$BUILD_MODE/novai-msg-recv \
        "$REMOTE_HOST:$TARGET_DIR/" || return 1

    echo "3. Setting execution permissions..."
    ssh "$REMOTE_HOST" "chmod +x $TARGET_DIR/*" || return 1

    echo "--- Deployment Complete ($BUILD_MODE) to $SIDE. Tools in $TARGET_DIR ---"
}

# ==============================================================================
# Git Helpers
# ==============================================================================

stash() {
    # Check if a comment argument was passed
    if [ -z "$1" ]; then
        echo "❌ Error: You must provide a stash comment!"
        echo "Usage: stash \"your comment here\""
        return 1
    fi

    # Execute the stash push including untracked files (-u)
    git stash push -u -m "$1"
}

# Smart display, reset, and apply/pop git stashes
stash_apply() {
    local action="apply"
    
    # Check for pop flags
    if [[ "$1" == "-p" || "$1" == "--pop" ]]; then
        action="pop"
    fi

    # 1. Fetch raw stash list
    local raw_list
    raw_list=$(git stash list)

    if [[ -z "$raw_list" ]]; then
        echo "ℹ️ No stashes found in this repository."
        return 0
    fi

    # 2. Display hyper-clean output using awk parsing
    echo "--- Available Stashes ---"
    echo "$raw_list" | awk -F': ' '
    {
        match($1, /[0-9]+/)
        idx = substr($1, RSTART, RLENGTH)
        branch_ctx = $2
        sub(/^(WIP on |On )/, "", branch_ctx)
        comment = $3
        for (i=4; i<=NF; i++) comment = comment ": " $i
        printf " [%s] %s -> %s\n", idx, branch_ctx, comment
    }'
    echo "-------------------------"

    # 3. Prompt user for the index number
    local index
    echo -n "Enter index to $action: "
    read index

    # 4. Input validation
    if [[ ! "$index" =~ ^[0-9]+$ ]]; then
        echo "❌ Error: '$index' is not a valid number."
        return 1
    fi

    if ! git stash list | grep -q "^stash@{$index}:"; then
        echo "❌ Error: Stash index [$index] does not exist."
        return 1
    fi

    # 5. SMART CHECK: Is the working directory dirty?
    if [[ -n $(git status --porcelain) ]]; then
        echo -n "⚠️ You have uncommitted changes. Hard reset workspace first? (y/N): "
        read -r response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            echo "💥 Wiping uncommitted modifications..."
            git reset --hard HEAD && git clean -fd
        else
            echo "⏩ Proceeding without reset (Git will attempt to merge)..."
        fi
    fi

    # 6. Execute the Git command
    echo "⚡ Executing: git stash $action stash@{$index}"
    git stash "$action" "stash@{$index}"
}

# ==============================================================================
# Desktop & Local Environment Utilities
# ==============================================================================

# Custom command to change and check mouse pointer size safely
setcursor() {
  # 1. Fetch current size (grep filters out 'uint32' text that GNOME sometimes adds)
  local current_size
  current_size=$(gsettings get org.gnome.desktop.interface cursor-size | grep -oE '[0-9]+')
  
  # 2. Map current size to a readable label
  local current_label
  case "$current_size" in
    24) current_label="Default" ;;
    48) current_label="Medium" ;;
    64) current_label="Large" ;;
    96) current_label="Huge" ;;
    *)  current_label="Custom" ;;
  esac

  # 3. If no argument is provided, display current size and exit
  if [ -z "$1" ]; then
    echo "Current size: $current_size ($current_label)"
    echo "Usage: setcursor <size>"
    echo "Common sizes: 24 (Default), 48 (Medium), 64 (Large), 96 (Huge)"
    return 0
  fi
  
  # 4. Check if the input is strictly numbers
  if ! [[ "$1" =~ ^[0-9]+$ ]]; then
    echo "Error: Cursor size must be a number (e.g., 48)."
    return 1
  fi
  
  # 5. Check if the number is within a safe range (16 to 128)
  if [ "$1" -lt 16 ] || [ "$1" -gt 128 ]; then
    echo "Error: Please choose a size between 16 and 128 to prevent interface glitches."
    return 1
  fi
  
  # 6. Apply the new setting
  gsettings set org.gnome.desktop.interface cursor-size "$1"
  
  # 7. Map new size to a readable label for the success message
  local new_label
  case "$1" in
    24) new_label="Default" ;;
    48) new_label="Medium" ;;
    64) new_label="Large" ;;
    96) new_label="Huge" ;;
    *)  new_label="Custom" ;;
  esac

  echo "Mouse pointer changed from $current_size ($current_label) to $1 ($new_label)!"
}

update_vscode() {
    local status=0

    # 1. Push current directory onto the stack and move to Downloads
    if pushd ~/Downloads > /dev/null; then
        
        echo "=== Downloading latest VS Code Debian package ==="
        if wget -O vscode_latest_amd64.deb "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"; then
            
            echo "=== Installing VS Code package ==="
            if sudo dpkg -i vscode_latest_amd64.deb; then
                # Clean up the installer binary to save space
                rm vscode_latest_amd64.deb
            else
                echo "Error: Installation failed. Installer kept in ~/Downloads." >&2
                status=1
            fi
        else
            echo "Error: Download failed." >&2
            status=1
        fi
        
        # 2. Pop directory stack to return to the original working directory
        popd > /dev/null
    else
        echo "Error: Could not access ~/Downloads directory." >&2
        return 1
    fi

    return "$status"
}

# Function to set a random dark background color
random_dark_bg() {
    # Array of beautiful, distinct dark hex colors
    local colors=(
        "#1E1E2E" # Catppuccin Mocha (Dark Grey/Blue)
        "#1A1B26" # Tokyo Night (Deep Night Blue)
        "#282A36" # Dracula Dark (Gothic Grey)
        "#1E222A" # One Dark Deep (Classic IDE Dark)
        "#0F1419" # Ayat Dark (Warm Charcoal)
        "#181825" # Deep Sapphire
        "#2E3440" # Nord Slate (Muted Blue/Grey)
        "#161616" # Carbon Black
        "#0D1117" # GitHub Dark
        "#1F1F2E" # Dark Indigo
        "#101C2C" # midnight blue
        "#142B45" # deep navy
        "#123847" # dark blue-teal
        "#202A35" # blue slate
        "#2B1D16" # espresso
        "#3D2519" # dark walnut
        "#49301E" # warm brown
        "#2E211C" # chestnut
    )

    # Use /dev/urandom to bypass Zsh's unseeded $RANDOM behavior on startup
    local rand_index=$(( ($(od -An -N2 -i /dev/urandom) % ${#colors[@]}) + 1 ))
    local chosen_color="${colors[$rand_index]}"

    # Send the escape sequence to the terminal to change the background color dynamically
    echo -ne "\e]11;${chosen_color}\a"
}

