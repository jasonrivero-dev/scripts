#!/usr/bin/env bash
set -euo pipefail

# Builds the novarc-licensing .deb (and example client binaries, if not
# already built) and copies everything needed to QA-test it on a bare EC2
# box - the package plus the installed-path-safe scripts, nothing that needs
# the cargo workspace itself. Does not install or provision anything remotely
# - that's a manual step over your own SSH session, printed at the end.

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

log() {
    echo -e "[$(date +"%H:%M:%S")] [${GREEN}INFO${NC}] $*"
}

warn() {
    echo -e "[$(date +"%H:%M:%S")] [${YELLOW}WARN${NC}] $*"
}

error() {
    echo -e "[$(date +"%H:%M:%S")] [${RED}ERROR${NC}] $*" >&2
}

divider() {
    echo "======================================================================"
}

REPO_DIR="${REPO_DIR:-$HOME/dev/licensing-poc}"
KEY_FILE="${KEY_FILE:-$HOME/.ec2/Edge-Licensing-Login-Pair.pem}"
REMOTE_USER="${REMOTE_USER:-ubuntu}"
REMOTE_HOST="${REMOTE_HOST:-35.162.41.238}"
REMOTE_DIR="${REMOTE_DIR:-/home/ubuntu/licensing-deploy}"

# Installed-path-safe only - see docs/TOOLS.md / feedback_qa_scripts_installed_paths_only.
# dev_build and air_gap_cert_tool are deliberately excluded (dev-workspace-only).
SCRIPTS_TO_COPY=(
    common
    dev_lib
    entitlement_lib
    health
    dev_logs
    qa_manage_entitlement
    dev_test_entitlements
    dev_test_proxy
    dev_test_e2e
    dev_test_mitm
    qa_test_clients
)

print_next_steps() {
    local deb_basename="$1"
    echo "  Connect and move to the deploy directory:"
    echo "       ssh -i $KEY_FILE ${REMOTE_USER}@${REMOTE_HOST}"
    echo "       cd ${REMOTE_DIR}"
    echo
    echo "  --- Factory Provisioning (Admin) - see docs/OPERATOR_HOWTO.md ---"
    echo "  1. Install the package (ensures acl/tpm2-tools first, then installs):"
    echo "       sudo ./install.sh ${deb_basename}"
    echo "  2. Bring-up check with a test license, as root:"
    echo "       sudo lictl init <test-license-id>"
    echo "       sudo lictl status"
    echo "       sudo lictl license   # expect every entitlement GRANTED"
    echo "  3. Wipe the test license, bring the daemon back up:"
    echo "       sudo lictl reset"
    echo "       sudo lictl start"
    echo "  4. Generate the licensing_su password for this box (shown once - write it down):"
    echo "       sudo lictl licensing-su-password"
    echo
    echo "  --- Field Provisioning (Field Operator) - see docs/OPERATOR_HOWTO.md ---"
    echo "  5. Log in as licensing_su (no root involved from here on):"
    echo "       ssh -i $KEY_FILE licensing_su@${REMOTE_HOST}"
    echo "     If that's rejected (publickey) - this box's sshd may not allow password auth -"
    echo "     fall back to, from your existing ${REMOTE_USER} session:"
    echo "       sudo su - licensing_su"
    echo "  6. Provision the real license, then confirm:"
    echo "       lictl init <license-id>"
    echo "       lictl status"
    echo "       lictl license"
    echo "     Then leave this session (exit/logout) - it has zero sudo rights by design,"
    echo "     including for the QA scripts below."
    echo
    echo "  --- QA (back in the ${REMOTE_USER} session - licensing_su has no sudo) ---"
    echo "  7. Run the end-to-end test:"
    echo "       sudo scripts/dev_test_e2e"
    echo "  8. Run the client tests:"
    echo "       sudo scripts/qa_test_clients"
    echo "  9. Or run an example client directly (needs cwd inside examples/ - the"
    echo "     binary looks for config.toml relative to where it's run, not itself):"
    echo "       cd examples && bin/client-cpp noveye   # no sudo needed - hits the daemon over HTTP"
}

do_uninstall() {
    if [ ! -f "$KEY_FILE" ]; then
        error "SSH key not found at $KEY_FILE (set KEY_FILE to override)."
        exit 1
    fi

    read -r -p "This will purge novarc-licensing and delete ${REMOTE_DIR} on ${REMOTE_HOST}. Continue? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        log "Aborted."
        exit 0
    fi

    echo
    divider
    log "Uninstalling novarc-licensing from ${REMOTE_USER}@${REMOTE_HOST}"
    divider
    ssh -t -i "$KEY_FILE" "${REMOTE_USER}@${REMOTE_HOST}" '
        set -e
        sudo dpkg --purge novarc-licensing || sudo dpkg --remove --force-remove-reinstreq novarc-licensing
        sudo apt-get -y --fix-broken install
        if dpkg -l novarc-licensing 2>/dev/null | grep -qE "^(ii|iU)"; then
            echo "novarc-licensing is still installed" >&2
            exit 1
        fi
        echo "novarc-licensing removed."
        rm -rf "'"$REMOTE_DIR"'"
        echo "Removed deploy directory '"$REMOTE_DIR"'."
    '
    divider
    log "Uninstall complete."
    divider
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    echo "Usage: licadmin-ec2-deploy [--uninstall]"
    echo
    echo "Builds the .deb + example clients, copies them plus the installed-path-safe"
    echo "QA scripts to the EC2 box below. Does not install/provision anything remotely -"
    echo "these are the manual steps to run yourself afterward, over your own SSH session:"
    echo
    print_next_steps "novarc-licensing_<version>_<arch>.deb"
    echo
    echo "--uninstall: purges novarc-licensing and deletes ${REMOTE_DIR} on the box above,"
    echo "             after a y/N confirmation prompt. Connects over SSH and runs it directly."
    exit 0
fi

if [ "${1:-}" = "--uninstall" ]; then
    do_uninstall
    exit 0
fi

if [ ! -d "$REPO_DIR" ]; then
    error "Repo not found at $REPO_DIR (set REPO_DIR to override)."
    exit 1
fi
if [ ! -f "$KEY_FILE" ]; then
    error "SSH key not found at $KEY_FILE (set KEY_FILE to override)."
    exit 1
fi

cd "$REPO_DIR"

log "Building .deb via ./build.sh deb..."
./build.sh deb

DEB_PATH=$(find target/debian -maxdepth 1 -name '*.deb' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
if [ -z "$DEB_PATH" ]; then
    error "No .deb found under target/debian after build."
    exit 1
fi
log "Built package: $DEB_PATH"

if [ ! -x "examples/bin/client-rust" ] || [ ! -x "examples/bin/client-go" ] || [ ! -x "examples/bin/client-cpp" ]; then
    log "Example client binaries missing - building locally via examples/build.sh..."
    (cd examples && ./build.sh)
fi

STAGE_DIR=$(mktemp -d)
trap 'rm -rf "$STAGE_DIR"' EXIT

log "Staging files in $STAGE_DIR..."
cp "$DEB_PATH" "$STAGE_DIR/"
cp package/install.sh "$STAGE_DIR/install.sh"

mkdir -p "$STAGE_DIR/scripts"
for f in "${SCRIPTS_TO_COPY[@]}"; do
    cp "scripts/$f" "$STAGE_DIR/scripts/$f"
done

mkdir -p "$STAGE_DIR/examples/bin"
cp examples/bin/client-rust examples/bin/client-go examples/bin/client-cpp "$STAGE_DIR/examples/bin/"
cp examples/config.toml "$STAGE_DIR/config.toml"

log "Copying to ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}..."
ssh -i "$KEY_FILE" "${REMOTE_USER}@${REMOTE_HOST}" "mkdir -p '$REMOTE_DIR'"
scp -i "$KEY_FILE" -r "$STAGE_DIR"/. "${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_DIR}/"

DEB_BASENAME=$(basename "$DEB_PATH")

log "Done. Files are at ${REMOTE_DIR} on the box. Next steps (manual, over your own SSH session):"
echo
print_next_steps "$DEB_BASENAME"
echo
if ! ssh -i "$KEY_FILE" "${REMOTE_USER}@${REMOTE_HOST}" "dpkg -s libcurl4 || dpkg -s libcurl4t64" &>/dev/null; then
    warn "client-cpp needs libcurl4 (+ its TLS chain) at runtime - if it fails to run, 'sudo apt install -y libcurl4t64 || sudo apt install -y libcurl4'."
fi
