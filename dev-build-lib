# dev-build-lib: Surgical Host-side Functions for Celeste

clean_host_build()
{
    log "Surgical Clean: Removing host-specific artifacts..."
    # Verbose removal confirms we are killing the specific CamelCase folder
    rm -rfv "${PROJECT_ROOT}/back_end/cmake-build-${BUILD_CONFIG}"
    rm -rfv "${PROJECT_ROOT}/back_end/libs/ffmpeg_recorder/build"
}

rebuild_metrics_host()
{
    log "Rebuilding Metrics (Host-side Clean Start)..."
    pushd "${PROJECT_ROOT}/third/metrics-cpp" > /dev/null
    rm -rf build_host
    mkdir -p build_host
    cmake -S . -B build_host -DCMAKE_INSTALL_PREFIX="${PROJECT_ROOT}/deps/metrics-cpp"
    cmake --build build_host --target metrics --config "$BUILD_CONFIG"
    cmake --install build_host
    popd > /dev/null
}

configure_and_build_host()
{
    log "Configuring Host CMake (Coverage: ${ENABLE_COV})..."
    
    local COV_FLAG="-DENABLE_COVERAGE=OFF"
    if [ "$ENABLE_COV" = true ]
    then
        COV_FLAG="-DENABLE_COVERAGE=ON"
    fi

    # Dynamically find toolchain to survive the 'relwithdebinfo' vs 'RelWithDebInfo' mess
    local TOOLCHAIN_FILE=$(find "${PROJECT_ROOT}/back_end" -name "conan_toolchain.cmake" | head -n 1)
    
    if [ -z "$TOOLCHAIN_FILE" ]
    then
        error "Conan toolchain not found! Run conan install on host."
    fi

    log "Using Toolchain: ${TOOLCHAIN_FILE}"
    mkdir -p "${BUILD_DIR}"
    
    cmake -G Ninja \
        ${COV_FLAG} \
        -DCMAKE_CXX_FLAGS="-fprofile-update=atomic" \
        -DCMAKE_TOOLCHAIN_FILE="${TOOLCHAIN_FILE}" \
        -DCMAKE_BUILD_TYPE="${BUILD_CONFIG}" \
        -DCMAKE_PREFIX_PATH="${PROJECT_ROOT}/deps/libtorch" \
        -DCMAKE_LIBRARY_PATH="${PROJECT_ROOT}/build" \
        -DCMAKE_CUDA_COMPILER=/usr/bin/nvcc \
        -S "${PROJECT_ROOT}/back_end" -B "${BUILD_DIR}"

    local TARGETS="celeste"
    if [ "$RUN_TESTS" = true ] || [ "$ENABLE_COV" = true ]
    then
        TARGETS="celeste tests recorder_tests ffmpeg_recorder"
    fi

    log "Executing Host Ninja (Targets: ${TARGETS})..."
    ninja -C "${BUILD_DIR}" ${TARGETS}
}

run_tests_host()
{
    log "Executing Host Unit Tests..."
    export LD_LIBRARY_PATH="${BUILD_DIR}:${LD_LIBRARY_PATH}"
    
    "${BUILD_DIR}/tests"
    "${BUILD_DIR}/test/recorder_tests"
}

process_coverage_host()
{
    log "Capturing Host Coverage (Surgical -d scan)..."
    local INFO_FILE="${PROJECT_ROOT}/coverage.info"
    local REPORT_DIR="${PROJECT_ROOT}/reports/host_coverage_report"

    # SURGICAL FIX: Added 'source' to ignore-errors to bypass Catch2 path whines
    lcov --capture --directory "${BUILD_DIR}" \
         --output-file "${INFO_FILE}" \
         --ignore-errors mismatch,source,gcov

    if [ ! -f "${INFO_FILE}" ]; then
        error "Coverage info file not found! Expected at: ${INFO_FILE}"
        return
    fi

    log "Filtering Noise..."
    # SURGICAL FIX: Added '--ignore-errors unused' to prevent exit on missing folders
    lcov --remove "${INFO_FILE}" \
         '/usr/*' \
         '*/third/*' \
         '*/test/*' \
         '*/fbs/*' \
         '*/_deps/*' \
         '*/cmake-build-*' \
         -o "${INFO_FILE}" \
         --quiet \
         --ignore-errors unused
    
    if [ ! -f "${INFO_FILE}" ]; then
        error "Filtered coverage info file not found! Expected at: ${INFO_FILE}"
        return
    fi

    log "Generating HTML Report..."
    rm -rfv "${REPORT_DIR}"
    mkdir -p "${REPORT_DIR}"
    # Ignore 'source' here to prevent genhtml from failing on external Catch2 files
    genhtml "${INFO_FILE}" \
            --output-directory "${REPORT_DIR}" \
            --ignore-errors source,unused \
            --quiet
    
    if [ ! -d "${REPORT_DIR}" ] || [ ! -f "${REPORT_DIR}/index.html" ]; then
        error "Coverage report directory not found! Expected at: ${REPORT_DIR}"
        error "Expected index.html at: ${REPORT_DIR}/index.html"
        return
    fi

    log "Host Coverage Success: ${REPORT_DIR}/index.html"
}