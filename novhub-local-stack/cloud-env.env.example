# cloud-check.sh's AWS region + named credentials profile, per environment - non-secret (a
# region code and a profile NAME, never a key/secret). Auto-created as cloud-env.env
# (git-ignored) from this file on first run. The region is derived from the endpoint
# hostnames themselves (*.us-west-2.*.amazonaws.com), not sensitive. AWS_PROFILE is left
# blank - set it to a profile already configured for the AWS CLI (SSO profiles live in
# ~/.aws/config, static-key profiles in ~/.aws/credentials). Never put a raw key here.
DEV_AWS_REGION=us-west-2
DEV_AWS_PROFILE=
# NovApi's robot-data S3 bucket for the dev cloud-local launcher.
DEV_S3_BUCKET_NAME=
# NovApi's JWT signing secret for the dev cloud-local launcher. Keep the actual value local.
JWT_SECRET=
TEST_AWS_REGION=us-west-2
TEST_AWS_PROFILE=

# Numeric robot id for cloud-check.sh's dev-write-privilege check (preset-row-exists count) -
# optional, leave blank to skip that one check. Not a secret, just a robot id.
DEV_INGEST_ROBOT_ID=
TEST_INGEST_ROBOT_ID=
