# cloud-tunnel.sh's local forward ports - non-secret, just port numbers. Auto-created as
# cloud-tunnel-ports.env (git-ignored) from this file on first run. Chosen well clear of this
# stack's own local ports (3000 NovApi, 5173 NovApp, 5433 local Postgres, 9200 local OpenSearch).
DEV_DB_LOCAL_PORT=25432
DEV_OPENSEARCH_LOCAL_PORT=25443
TEST_DB_LOCAL_PORT=25433
TEST_OPENSEARCH_LOCAL_PORT=25444
