# cloud-tunnel.sh's local forward addresses/ports - non-secret. Auto-created as
# cloud-tunnel-ports.env (git-ignored) from this file on first run.
#
# DB forward: an ordinary high port on 127.0.0.1 - no port-in-signature issue, so one shared
# loopback address with a distinct port per env is enough. Chosen well clear of this stack's
# own local ports (3000 NovApi, 5173 NovApp, 5433 local Postgres, 9200 local OpenSearch).
DEV_DB_LOCAL_PORT=25432
TEST_DB_LOCAL_PORT=25433

# OpenSearch forward: must be port 443 on the address the real hostname resolves to (see
# cloud-hosts.sh) - AWS SigV4 signs the Host header, which must carry no port at all to match
# what AWS recomputes server-side, so the tunnel's local port can't be a high port the way the
# DB one is. 443 is privileged, so each env needs its OWN loopback address (127.0.0.1,
# 127.0.0.2, ...) to have its own port 443 and let both be open at once - any address in
# 127.0.0.0/8 works with no extra setup.
DEV_OPENSEARCH_LOOPBACK=127.0.0.1
TEST_OPENSEARCH_LOOPBACK=127.0.0.2
