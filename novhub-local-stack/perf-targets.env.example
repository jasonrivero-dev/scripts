# perf-capture.sh/perf-after.sh's --target local robot + URLs - auto-created as perf-targets.env
# (git-ignored) from this file on first run. For any other --target NAME, copy this format into
# your own perf-targets.<NAME>.env instead - never put real values in this committed .example.
# Credentials go only in a 0600 secret file, never in either config file.
PERF_ROBOT_NAME=PERF-ING-910001
NOVAPP_URL=http://localhost:5173
NOVAPI_URL=http://localhost:3000

# Analytics' fixed date range (YYYY-MM-DD, both or neither) - the page has no URL param for
# this, perf-capture.js sets it through the picker UI itself. Required for any non-local
# --target; optional locally (left blank here - the page just keeps its default range).
PERF_RANGE_START=
PERF_RANGE_END=
